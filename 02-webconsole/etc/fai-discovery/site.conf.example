# /etc/fai-discovery/site.conf
#
# Site-spezifische Werte für die fai-discovery-Webkonsole. Diese Datei
# wird NICHT versioniert (siehe .gitignore-Muster von admins.json) - nur
# diese Vorlage liegt im Repo. Auf einem neuen FAI-Server erzeugt
# install.sh diese Datei interaktiv; manuell: nach
# /etc/fai-discovery/site.conf kopieren und Werte anpassen.

# Pfad zur FAI-Profil-Datei (*.profile), deren Einträge im
# Freigabe-Formular der Webkonsole zur Auswahl stehen.
FAI_DISCOVERY_PROFILE_FILE=/srv/fai/config/class/example.profile

# URL, unter der die Webkonsole von innerhalb des FAI-NFSROOT (also vom
# Zielrechner während der Installation) erreichbar ist - genutzt von
# hooks/discovery und class/02-set-hostname.sh im fai-config-Configspace.
# WICHTIG: Immer den vollqualifizierten Hostnamen (FQDN) verwenden, nie
# einen Kurznamen. Das minimale NFS-Root-Boot-Environment übernimmt beim
# Booten meist nur DNS-Server-IPs, aber keine DNS-Search-Domain - ein
# Kurzname wie "faiserver" ist dort dann nicht auflösbar, wodurch die
# Registrierung bei der Webkonsole stillschweigend fehlschlägt
# (curl-Fehler im Boot-Log, Client fällt in eine Shell des
# Nfsroot-Basissystems zurück). "hostname -f" liefert normalerweise den
# richtigen Wert.
FAI_DISCOVERY_INTERNAL_URL=http://faiserver.example.com:8080

# NFS-Root-Server für die FAI-Installation (an "fai-chboot -u" übergeben).
# Muss vom ZIELRECHNER während der Installation erreichbar sein - anders
# als die übrigen Variablen in dieser Datei löst NICHT der FAI-Server
# selbst diese Adresse auf, sondern der Client. "localhost" ist daher
# fast immer falsch. Üblicherweise Hostname oder IP des FAI-Servers.
# PFLICHT - ohne gesetzten Wert schlägt jede Freigabe fehl.
FAI_DISCOVERY_NFS_ROOT=nfs://faiserver/srv/fai/config

# Optionale Boot-URL für Kernel/Initrd des NFSROOT (an "fai-chboot -U"
# übergeben, unabhängig von FAI_DISCOVERY_NFS_ROOT/"-u" oben). Lädt
# Kernel/Initrd per HTTP statt TFTP - deutlich schneller, aber nur
# wirksam, wenn der Client bereits per TFTP den HTTP-fähigen Bootloader
# lpxelinux.0 geladen hat (DHCP-"filename" muss auf "fai/lpxelinux.0"
# zeigen, nicht "fai/pxelinux.0") und ein Webserver das TFTP-Verzeichnis
# (/srv/tftp/fai) unter dieser URL bereitstellt. Siehe
# https://fai-project.org/fai-guide/#_how_to_use_http_for_pxe_boot.
# Optional - leer/auskommentiert lässt Kernel/Initrd wie bisher per TFTP
# laden.
#FAI_DISCOVERY_BOOT_URL=http://faiserver/fai/

# Optionale Präfix-Listen für die "Hilfen für den Hostnamen" im
# Freigabe-Formular (kommagetrennte Code:Label-Paare). Fehlt eine der
# beiden Variablen, entfällt der zugehörige Dropdown-Block ersatzlos.
# WICHTIG: Die Reihenfolge ist relevant — der jeweils erste Eintrag ist
# die Vorauswahl im Dropdown, den häufigsten Fall also an Position 1
# setzen.
# WICHTIG: site.conf wird per EnvironmentFile beim Start des Diensts
# eingelesen — nach jeder Änderung dieser Datei (auch nur einer Zeile)
# ist ein "systemctl restart fai-discovery-webconsole" nötig, sonst
# bleiben die neuen Werte unwirksam.
#FAI_DISCOVERY_TYPE_PREFIXES=NB:Notebook,DT:Desktop,SRV:Server
#FAI_DISCOVERY_LOCATION_PREFIXES=K:Köln,B:Berlin,M:München

# Verzeichnis mit den FAI disk_config-Dateien, in dem beim Freigeben nach
# passenden "<Klasse>_EFI"-Varianten gesucht wird (automatische
# UEFI-Erkennung, siehe Hilfe-Seite der Webkonsole). Optional — ohne
# gesetzten Wert wird der FAI-Standardpfad verwendet.
#FAI_DISCOVERY_DISK_CONFIG_DIR=/srv/fai/config/disk_config

# Sprache der Webkonsole (Navigation, Formulare, Fehlermeldungen, Hilfe-
# Seite). Erlaubte Werte: "de" oder "en". Optional — fehlt die Variable
# oder hat sie einen anderen Wert, bleibt es beim bisherigen Verhalten
# (Deutsch).
# WICHTIG: site.conf wird per EnvironmentFile beim Start des Diensts
# eingelesen — nach jeder Änderung dieser Datei ist ein
# "systemctl restart fai-discovery-webconsole" nötig, sonst bleibt der
# neue Wert unwirksam.
#FAI_DISCOVERY_LANGUAGE=de

# Verzeichnis mit den per FAI savelog nach jeder Installation abgelegten
# Log-Dateien (LOGUSER-Home auf dem FAI-Server, siehe fai.conf(5)). Wird
# für den "Logs"-Link in der Historie genutzt. Optional — ohne gesetzten
# Wert wird der FAI-Standardpfad /var/log/fai/remote-logs verwendet.
#FAI_DISCOVERY_LOG_DIR=/var/log/fai/remote-logs

# Aktiviert einen unauthentifizierten Prometheus-/metrics-Endpoint (u.a.
# Anzahl Geraete je Status als Gauge). Optional, Default aus. Kein Auth,
# da Port 8080 fuer den unauthentifizierten Discovery-Client ohnehin
# offen sein muss (siehe FAI_DISCOVERY_NFS_ROOT-Kommentar) und die
# Werte reine Aggregatzahlen sind.
# WICHTIG: site.conf wird per EnvironmentFile beim Start des Diensts
# eingelesen — nach jeder Änderung dieser Datei ist ein
# "systemctl restart fai-discovery-webconsole" nötig, sonst bleibt der
# neue Wert unwirksam.
#FAI_DISCOVERY_METRICS_ENABLED=true

# Opt-in PXE boot menu for unknown clients (see the installation documentation).
# Only the exact value "true" enables it; default is off. When on, install.sh
# (and a systemd path unit after every kernel change) rebuilds
# pxelinux.cfg/default as a menu: "Boot from local disk" (default after the
# timeout) or "Discover this device (register for network install)".
# Machines already known to the web console (status reboot/reinstalling, i.e.
# everything in the history) skip the menu: fai-discovery-known gives each of
# them its own pxelinux.cfg/01-<mac> with "localboot -1". Every other machine
# that boots from the network before its disk waits TIMEOUT seconds in this
# menu. Before enabling, the DHCP server must hand UEFI clients
# fai/efi64/syslinux.efi instead of fai/syslinux.efi, and the script must have
# run once with --assets-only.
#FAI_DISCOVERY_MENU_ENABLED=true

# Seconds the menu waits before booting from the local disk (1-300, default 10).
#FAI_DISCOVERY_MENU_TIMEOUT=10

# Optional: HTTPS fuer die Webkonsole ueber Caddy als Reverse Proxy (Port 443 -> 127.0.0.1:8080).
# Ausfuehrlich in HOWTO-https.md. install.sh schreibt daraus /etc/caddy/Caddyfile (bin/fai-discovery-tls).
# Die Installations-Clients (/register, /status, /device) bleiben immer auf http://...:8080.
#   acme      Zertifikat von einer ACME-CA (z.B. step-ca), siehe FAI_DISCOVERY_TLS_ACME_CA
#   internal  Caddys eingebaute CA, keine CA noetig; deren root.crt einmalig in Browser/System importieren
#   files     selbst erzeugtes Zertifikat (z.B. eigene openssl-CA), siehe FAI_DISCOVERY_TLS_CERT_FILE
#   off/leer  kein HTTPS; eine frueher von install.sh geschriebene Caddyfile wird wieder entfernt
#FAI_DISCOVERY_TLS_MODE=acme

# Name im Zertifikat und Ziel der Umleitung (FQDN). Default: hostname -f
#FAI_DISCOVERY_TLS_HOST=faiserver.example.com

# Weitere Namen/IPv4-Adressen im Zertifikat (kommagetrennt), z.B. die Verwaltungs-IP. Bei acme muss die
# CA jeden Namen pruefen koennen.
#FAI_DISCOVERY_TLS_EXTRA_NAMES=192.0.2.10

# HTTPS-Port (Default 443). Port 80 bleibt in jedem Modus frei (z.B. fuer FAI_DISCOVERY_BOOT_URL).
#FAI_DISCOVERY_TLS_PORT=443

# Nur acme: Directory-URL der CA und deren Root-Zertifikat (fehlt es, gilt der System-Truststore).
#FAI_DISCOVERY_TLS_ACME_CA=https://ca.example.com/acme/acme/directory
#FAI_DISCOVERY_TLS_ACME_CA_ROOT=/usr/local/share/ca-certificates/example-root.crt

# Nur acme: Challenge. tls-alpn-01 (Default) braucht nur den HTTPS-Port, die CA muss sie aber anbieten
# (bei step-ca in der challenges-Liste des ACME-Provisioners). http-01 braucht Port 80 frei auf diesem
# Server - nicht moeglich, wenn dort schon ein Webserver laeuft (z.B. fuer FAI_DISCOVERY_BOOT_URL).
#FAI_DISCOVERY_TLS_ACME_CHALLENGE=tls-alpn-01

# Nur files: Zertifikat (mit Zwischenzertifikaten) und Schluessel, fuer den Benutzer caddy lesbar.
#FAI_DISCOVERY_TLS_CERT_FILE=/etc/caddy/certs/faiserver.crt
#FAI_DISCOVERY_TLS_KEY_FILE=/etc/caddy/certs/faiserver.key

# Admin-Seiten nur noch ueber HTTPS: direkte Aufrufe auf Port 8080 werden auf https://FAI_DISCOVERY_TLS_HOST
# umgeleitet (POST: 403), bevor nach dem Passwort gefragt wird. Erst setzen, wenn HTTPS funktioniert.
# Danach "systemctl restart fai-discovery-webconsole". Skripte wie fai-discovery-approve.sh muessen dann
# die https://-Adresse nutzen.
#FAI_DISCOVERY_ADMIN_HTTPS_ONLY=true
