#!/bin/bash
# fai-discovery-menu - builds the PXE boot menu for unknown clients
# (pxelinux.cfg/default) and maintains the Syslinux modules it needs.
#
# BIOS and UEFI need *different* menu.c32/libutil.c32/libcom32.c32 builds that
# share the same file names, so BIOS keeps its modules in the TFTP root and
# UEFI gets its own directory efi64/ (loaded via a DHCP boot file of
# fai/efi64/syslinux.efi). efi64/ links back to the shared pxelinux.cfg, the
# kernels/initrds and shredos/, so per-MAC configs written by fai-chboot (which
# use paths relative to the boot file) keep working for UEFI.
#
# Usage:
#   fai-discovery-menu                 build/restore the menu according to site.conf
#   fai-discovery-menu --assets-only   only modules, efi64/ and symlinks; leave default alone
#
# Runs as root from install.sh and a systemd unit. Idempotent.
set -euo pipefail

SITE_CONF="${FAI_DISCOVERY_SITE_CONF:-/etc/fai-discovery/site.conf}"
TFTP_DIR="${FAI_DISCOVERY_TFTP_DIR:-/srv/tftp/fai}"
SYSLINUX_MODULES="${FAI_DISCOVERY_SYSLINUX_MODULES:-/usr/lib/syslinux/modules}"
FAI_CHBOOT="${FAI_DISCOVERY_FAI_CHBOOT:-/usr/sbin/fai-chboot}"
# Empty value (not just unset) disables chown - used by the tests.
TFTP_OWNER="${FAI_DISCOVERY_TFTP_OWNER-fai:nogroup}"

NFS_RE='^nfs://[A-Za-z0-9_.-]+(/[A-Za-z0-9_./-]*)?$'
BOOT_URL_RE='^http://[A-Za-z0-9_.-]+(/[A-Za-z0-9_./-]*)?$'
# Same Lenovo ACPI _OSI quirk as bin/fai-discovery-chboot (kept in sync by hand;
# see the comment there for the background).
LENOVO_ACPI_OSI_QUIRK="acpi_osi='!Linux-Lenovo-NV-HDMI-Audio'"

MARKER="# fai-discovery-menu: managed file, do not edit"
# Synthetic, locally administered MAC; fai-chboot writes its config to
# pxelinux.cfg/01-02-00-00-00-00-99, which is deleted again right away.
DUMMY_MAC="02:00:00:00:00:99"
CFG_DIR="$TFTP_DIR/pxelinux.cfg"
DUMMY_FILE="$CFG_DIR/01-${DUMMY_MAC//:/-}"
DEFAULT_FILE="$CFG_DIR/default"
DEFAULT_NEW="$CFG_DIR/.default.new"
DEFAULT_BACKUP="$CFG_DIR/default.pre-fai-discovery-menu"

log() { echo "fai-discovery-menu: $*"; }
die() { echo "fai-discovery-menu: FEHLER: $*" >&2; exit 1; }

set_owner() {
    if [ -n "$TFTP_OWNER" ]; then
        chown -h "$TFTP_OWNER" "$@"
    fi
}

# conf_get KEY - last "KEY=value" line of site.conf (never sourced), one pair of
# surrounding double quotes removed. Commented-out lines do not match.
conf_get() {
    local line
    line=$(grep -E "^$1=" "$SITE_CONF" 2>/dev/null | tail -1 || true)
    line="${line#*=}"
    line="${line%\"}"
    line="${line#\"}"
    printf '%s' "$line"
}

# install_if_changed SRC DST - copy only when content differs.
install_if_changed() {
    local src="$1" dst="$2"
    [ -f "$src" ] || die "Quelle fehlt: $src"
    if ! cmp -s "$src" "$dst"; then
        install -m 644 "$src" "$dst"
        set_owner "$dst"
        log "aktualisiert: $dst"
    fi
}

sync_assets() {
    local efi="$TFTP_DIR/efi64" m f l
    [ -d "$TFTP_DIR" ] || die "TFTP-Verzeichnis fehlt: $TFTP_DIR"
    [ -f "$TFTP_DIR/syslinux.efi" ] || die "$TFTP_DIR/syslinux.efi fehlt (UEFI-Bootloader)"

    for m in menu.c32 libutil.c32 libcom32.c32; do
        install_if_changed "$SYSLINUX_MODULES/bios/$m" "$TFTP_DIR/$m"
    done

    if [ ! -d "$efi" ]; then
        mkdir -p "$efi"
        chmod 755 "$efi"
        set_owner "$efi"
        log "angelegt: $efi"
    fi
    for m in ldlinux.e64 menu.c32 libutil.c32 libcom32.c32; do
        install_if_changed "$SYSLINUX_MODULES/efi64/$m" "$efi/$m"
    done
    install_if_changed "$TFTP_DIR/syslinux.efi" "$efi/syslinux.efi"

    ln -sfn ../pxelinux.cfg "$efi/pxelinux.cfg"
    ln -sfn ../shredos "$efi/shredos"

    shopt -s nullglob
    for f in "$TFTP_DIR"/vmlinuz-* "$TFTP_DIR"/initrd.img-*; do
        ln -sfn "../$(basename "$f")" "$efi/$(basename "$f")"
    done
    for l in "$efi"/vmlinuz-* "$efi"/initrd.img-*; do
        if [ -L "$l" ] && [ ! -e "$l" ]; then
            rm -f "$l"
            log "entfernt (verwaist): $l"
        fi
    done
    shopt -u nullglob
}

# What fai-chboot itself writes for "default" (boot from disk).
plain_default_content() {
    printf 'default fai-generated\n\nlabel fai-generated\nlocalboot -1\n\n# generated by fai-chboot for host default with IP no IP\n'
}

is_managed_default() {
    [ -f "$DEFAULT_FILE" ] && head -1 "$DEFAULT_FILE" | grep -qxF "$MARKER"
}

# Disabled: give back the plain localboot default, but only if the file is ours.
restore_plain_default() {
    if is_managed_default; then
        plain_default_content > "$DEFAULT_NEW"
        chmod 644 "$DEFAULT_NEW"
        set_owner "$DEFAULT_NEW"
        mv -f "$DEFAULT_NEW" "$DEFAULT_FILE"
        log "Menue deaktiviert, localboot-default wiederhergestellt"
    fi
}

# Enabled: keep a hand-made default once before we replace it.
backup_foreign_default() {
    [ -f "$DEFAULT_FILE" ] || return 0
    [ -e "$DEFAULT_BACKUP" ] && return 0
    is_managed_default && return 0
    if cmp -s "$DEFAULT_FILE" <(plain_default_content); then
        return 0
    fi
    cp -p "$DEFAULT_FILE" "$DEFAULT_BACKUP"
    log "eigene default gesichert: $DEFAULT_BACKUP"
}

write_default_menu() {
    local nfs_root="$1" boot_url="$2" timeout="$3"
    local kernel append
    local -a args

    # Globals on purpose: the EXIT trap fires after this function has returned.
    trap 'rm -f "$DUMMY_FILE" "$DEFAULT_NEW"' EXIT

    args=(-Fv -u "$nfs_root")
    if [ -n "$boot_url" ]; then
        args+=(-U "$boot_url")
    fi
    "$FAI_CHBOOT" "${args[@]}" -k "$LENOVO_ACPI_OSI_QUIRK" -a discovery "$DUMMY_MAC" >/dev/null \
        || die "fai-chboot fehlgeschlagen - default bleibt unveraendert"
    [ -f "$DUMMY_FILE" ] || die "fai-chboot hat $DUMMY_FILE nicht erzeugt - default bleibt unveraendert"

    kernel=$(awk '/^linux /{print $2; exit}' "$DUMMY_FILE")
    append=$(awk '/^append /{sub(/^append /,""); print; exit}' "$DUMMY_FILE")
    [[ "$kernel" =~ ^vmlinuz-[A-Za-z0-9._+~-]+$ ]] \
        || die "unerwarteter Kernelname '$kernel' - default bleibt unveraendert"
    case "$append" in
        *FAI_ACTION=discovery*) ;;
        *) die "append-Zeile ohne FAI_ACTION=discovery - default bleibt unveraendert" ;;
    esac

    {
        printf '%s\n' "$MARKER"
        cat <<EOF
UI menu.c32
PROMPT 0
TIMEOUT $((timeout * 10))
ONTIMEOUT local
NOESCAPE 1

MENU TITLE  fai-discovery  -  PXE Boot
MENU AUTOBOOT Automatic boot from local disk in # seconds...
MENU TABMSG  Use arrow keys and Enter to choose
MENU MARGIN 8
MENU WIDTH 72

MENU COLOR screen      37;44  #ffffffff #ff1c3a5e std
MENU COLOR border      36;44  #ff5fb3ff #ff1c3a5e std
MENU COLOR title       1;33;44 #ffffd75f #ff1c3a5e std
MENU COLOR unsel       37;44  #ffffffff #ff1c3a5e std
MENU COLOR hotkey      1;33;44 #ffffd75f #ff1c3a5e std
MENU COLOR sel         30;42  #ff000000 #ff5fd75f std
MENU COLOR hotsel      30;42  #ff000000 #ff5fd75f std
MENU COLOR timeout_msg 1;36;44 #ff5fffff #ff1c3a5e std
MENU COLOR timeout     1;31;44 #ffff5f5f #ff1c3a5e std
MENU COLOR tabmsg      36;44  #ff5fb3ff #ff1c3a5e std

LABEL local
  MENU LABEL Boot from ^local disk
  MENU DEFAULT
  localboot -1

LABEL discover
  MENU LABEL ^Discover this device (register for network install)
  linux $kernel
  append $append
EOF
    } > "$DEFAULT_NEW"

    if grep -qx 'LABEL local' "$DEFAULT_NEW" \
        && grep -qx 'ONTIMEOUT local' "$DEFAULT_NEW" \
        && grep -q 'FAI_ACTION=discovery' "$DEFAULT_NEW"; then
        :
    else
        die "erzeugtes Menue unvollstaendig - default bleibt unveraendert"
    fi

    if cmp -s "$DEFAULT_NEW" "$DEFAULT_FILE"; then
        rm -f "$DEFAULT_NEW"
        return 0
    fi
    backup_foreign_default
    chmod 644 "$DEFAULT_NEW"
    set_owner "$DEFAULT_NEW"
    mv -f "$DEFAULT_NEW" "$DEFAULT_FILE"
    log "default aktualisiert (Kernel $kernel, Timeout ${timeout}s)"
}

assets_only=0
case "${1:-}" in
    "") ;;
    --assets-only) assets_only=1 ;;
    *) die "Unbekannte Option '$1' (erlaubt: --assets-only)" ;;
esac

if [ "$assets_only" -eq 1 ]; then
    sync_assets
    exit 0
fi

[ -f "$SITE_CONF" ] || die "site.conf nicht gefunden: $SITE_CONF"
[ -d "$CFG_DIR" ] || die "$CFG_DIR fehlt"

if [ "$(conf_get FAI_DISCOVERY_MENU_ENABLED)" != "true" ]; then
    restore_plain_default
    exit 0
fi

timeout=$(conf_get FAI_DISCOVERY_MENU_TIMEOUT)
timeout="${timeout:-10}"
[[ "$timeout" =~ ^[0-9]+$ ]] || die "FAI_DISCOVERY_MENU_TIMEOUT '$timeout' ist keine Zahl"
timeout=$((10#$timeout))
{ [ "$timeout" -ge 1 ] && [ "$timeout" -le 300 ]; } \
    || die "FAI_DISCOVERY_MENU_TIMEOUT $timeout ausserhalb 1-300"

nfs_root=$(conf_get FAI_DISCOVERY_NFS_ROOT)
[[ "$nfs_root" =~ $NFS_RE ]] || die "FAI_DISCOVERY_NFS_ROOT '$nfs_root' fehlt oder ist keine gueltige nfs://-URL"

boot_url=$(conf_get FAI_DISCOVERY_BOOT_URL)
if [ -n "$boot_url" ] && ! [[ "$boot_url" =~ $BOOT_URL_RE ]]; then
    die "FAI_DISCOVERY_BOOT_URL '$boot_url' ist keine gueltige http://-URL"
fi

sync_assets
write_default_menu "$nfs_root" "$boot_url" "$timeout"
