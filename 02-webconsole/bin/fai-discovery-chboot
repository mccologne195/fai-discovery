#!/bin/bash
# fai-discovery-chboot - schmaler root-privilegierter Wrapper um fai-chboot.
# Wird über sudo vom faidiscovery-Systemuser aufgerufen (siehe
# /etc/sudoers.d/fai-discovery), der selbst unprivilegiert bleibt.
set -euo pipefail

MAC_RE='^[0-9a-f]{2}(:[0-9a-f]{2}){5}$'
NFS_RE='^nfs://[A-Za-z0-9_.-]+(/[A-Za-z0-9_./-]*)?$'
BOOT_URL_RE='^http://[A-Za-z0-9_.-]+(/[A-Za-z0-9_./-]*)?$'
BOOL_RE='^[01]$'

# Lenovo-ACPI-_OSI-Quirk (siehe fai-config/class/55-lenovo-quirks fuer den
# vollen Hintergrund - T490 mit NVIDIA-Optimus haelt ohne diesen Parameter
# die dGPU dauerhaft in Power-State D0 und meldet "ACPI BIOS Error: Could
# not resolve symbol [\_SB.PCI0.RP09.PEGP.NVDM]"). Der ACPI-_OSI-Bug sitzt
# in der Geraete-Firmware selbst, nicht im installierten OS - betrifft also
# genauso den Discovery-/Install-Kernel, den fai-chboot hier per PXE bootet,
# lange bevor fai-config je zum Zug kommt. Deshalb bewusst hier UNBEDINGT
# (nicht nur fuer erkannte T490s) in die Kernel-Cmdline aller Discovery-/
# Install-Boots aufgenommen - der Parameter setzt nur eine sehr spezifische,
# Lenovo-eigene _OSI-Vendor-Zeichenkette auf "nicht unterstuetzt" und ist
# auf jeder anderen Hardware nachweislich wirkungslos (kein Geraet ausser
# genau diesem Lenovo-Firmware-Pfad prueft je auf diese Zeichenkette). Eine
# Erkennung wie in fai-config waere hier ohnehin nicht moeglich: beim
# allerersten (Discovery-)Boot eines unbekannten Geraets kennt die
# Webkonsole dessen Hardware-Modell noch gar nicht.
LENOVO_ACPI_OSI_QUIRK="acpi_osi='!Linux-Lenovo-NV-HDMI-Audio'"

if [ "$#" -lt 1 ]; then
    echo "Nutzung: $0 approve <MAC> <FAI_KLASSEN> <NFS_ROOT> <REBOOT 0|1> <VERBOSE 0|1> <BOOT_URL|''> | $0 discovery <MAC> <NFS_ROOT> <BOOT_URL|''> | $0 disable <MAC> | $0 wipe <MAC>" >&2
    exit 1
fi

mode=$1
shift

case "$mode" in
  approve)
    if [ "$#" -ne 6 ]; then
        echo "Nutzung: $0 approve <MAC> <FAI_KLASSEN> <NFS_ROOT> <REBOOT 0|1> <VERBOSE 0|1> <BOOT_URL|''>" >&2
        exit 1
    fi
    mac=$1
    classes=$2
    nfs_root=$3
    reboot=$4
    verbose=$5
    boot_url=$6
    if ! [[ "$mac" =~ $MAC_RE ]]; then
        echo "Fehler: '$mac' ist keine gültige MAC-Adresse (Format aa:bb:cc:dd:ee:ff)" >&2
        exit 1
    fi
    if ! [[ "$classes" =~ ^[A-Za-z0-9_\ -]+$ ]]; then
        echo "Fehler: '$classes' enthält ungültige Zeichen für FAI-Klassen" >&2
        exit 1
    fi
    if ! [[ "$nfs_root" =~ $NFS_RE ]]; then
        echo "Fehler: '$nfs_root' ist keine gültige NFS-URL (Format nfs://host/pfad)" >&2
        exit 1
    fi
    if ! [[ "$reboot" =~ $BOOL_RE ]] || ! [[ "$verbose" =~ $BOOL_RE ]]; then
        echo "Fehler: REBOOT und VERBOSE müssen jeweils 0 oder 1 sein" >&2
        exit 1
    fi
    if [ -n "$boot_url" ] && ! [[ "$boot_url" =~ $BOOT_URL_RE ]]; then
        echo "Fehler: '$boot_url' ist keine gültige Boot-URL (Format http://host/pfad, leer lässt Kernel/Initrd per TFTP laden)" >&2
        exit 1
    fi
    # FAI_FLAGS wird bewusst selbst zusammengesetzt statt -F/-B zu nutzen,
    # damit reboot und verbose unabhängig voneinander schaltbar sind (siehe
    # fai-chboot-Manpage: -F = "verbose,sshd,createvt", -B = "verbose,sshd,reboot").
    # createvt hält den Client nach der Installation an, bis am Gerät
    # selbst ENTER gedrückt wird - reboot startet ihn stattdessen automatisch neu.
    flags="sshd"
    if [ "$reboot" = "1" ]; then
        flags="$flags,reboot"
    else
        flags="$flags,createvt"
    fi
    if [ "$verbose" = "1" ]; then
        flags="verbose,$flags"
    fi
    # FAI_SENDID=mac: die fai-monitor-Meldungen (TASKBEGIN/TASKEND) nutzen
    # sonst $HOSTNAME als Kennung, den FAI schon im allerersten Task
    # (confdir) einmalig fixiert - lange bevor 02-set-hostname.sh den
    # von der Webkonsole zugewiesenen Hostnamen setzt. Mit FAI_SENDID=mac
    # sendet der Client stattdessen die von Anfang an bekannte MAC-Adresse,
    # die die Webkonsole ohnehin schon kennt (siehe progress.py).
    # -v bleibt unabhängig von der verbose-Klassenoption immer gesetzt -
    # das ist fai-chboots eigene Ausgabe, die die Webkonsole bei Fehlern anzeigt.
    # -U ist ein eigener fai-chboot-Schalter (Kernel/Initrd per HTTP statt TFTP,
    # braucht lpxelinux.0 + passende DHCP-filename-Direktive auf dem Server) -
    # unabhängig von -u (Config-Space-Quelle), deshalb nur bei gesetzter
    # FAI_DISCOVERY_BOOT_URL ergänzt.
    boot_url_args=()
    if [ -n "$boot_url" ]; then
        boot_url_args=(-U "$boot_url")
    fi
    exec /usr/sbin/fai-chboot -I -f "$flags" -v -u "$nfs_root" "${boot_url_args[@]}" -k "FAI_SENDID=mac ADDCLASSES=${classes// /,} $LENOVO_ACPI_OSI_QUIRK" "$mac"
    ;;
  discovery)
    if [ "$#" -ne 3 ]; then
        echo "Nutzung: $0 discovery <MAC> <NFS_ROOT> <BOOT_URL|''>" >&2
        exit 1
    fi
    mac=$1
    nfs_root=$2
    boot_url=$3
    if ! [[ "$mac" =~ $MAC_RE ]]; then
        echo "Fehler: '$mac' ist keine gültige MAC-Adresse (Format aa:bb:cc:dd:ee:ff)" >&2
        exit 1
    fi
    if ! [[ "$nfs_root" =~ $NFS_RE ]]; then
        echo "Fehler: '$nfs_root' ist keine gültige NFS-URL (Format nfs://host/pfad)" >&2
        exit 1
    fi
    if [ -n "$boot_url" ] && ! [[ "$boot_url" =~ $BOOT_URL_RE ]]; then
        echo "Fehler: '$boot_url' ist keine gültige Boot-URL (Format http://host/pfad, leer lässt Kernel/Initrd per TFTP laden)" >&2
        exit 1
    fi
    boot_url_args=()
    if [ -n "$boot_url" ]; then
        boot_url_args=(-U "$boot_url")
    fi
    exec /usr/sbin/fai-chboot -Fv -u "$nfs_root" "${boot_url_args[@]}" -k "$LENOVO_ACPI_OSI_QUIRK" -a discovery "$mac"
    ;;
  disable)
    if [ "$#" -ne 1 ]; then
        echo "Nutzung: $0 disable <MAC>" >&2
        exit 1
    fi
    mac=$1
    if ! [[ "$mac" =~ $MAC_RE ]]; then
        echo "Fehler: '$mac' ist keine gültige MAC-Adresse (Format aa:bb:cc:dd:ee:ff)" >&2
        exit 1
    fi
    exec /usr/sbin/fai-chboot -d "$mac"
    ;;
  wipe)
    if [ "$#" -ne 1 ]; then
        echo "Nutzung: $0 wipe <MAC>" >&2
        exit 1
    fi
    mac=$1
    if ! [[ "$mac" =~ $MAC_RE ]]; then
        echo "Fehler: '$mac' ist keine gültige MAC-Adresse (Format aa:bb:cc:dd:ee:ff)" >&2
        exit 1
    fi
    # fai-chboot kennt ShredOS nicht - die PXE-Config wird direkt geschrieben,
    # im selben Verzeichnis/Namensformat, das fai-chboot selbst fuer "approve"/
    # "discovery" oben erzeugt (01-<mac-mit-bindestrichen>, siehe fai-chboot(8)).
    # syslinux.efi (UEFI-Bootpfad) und pxelinux.0/lpxelinux.0 (BIOS) sind beide
    # aus der SYSLINUX-Familie und lesen dasselbe Config-Format aus demselben
    # Verzeichnis - eine gemeinsame Config deckt daher beide Firmwares ab, kein
    # separater UEFI/GRUB-Zweig noetig (der vorhandene grub-uefi/-Pfad ist ein
    # deaktiviertes alt-Experiment, siehe grub-uefi/grub.cfg.disabled).
    #
    # ShredOS-Kernel (/srv/tftp/fai/shredos/vmlinuz) muss einmalig manuell
    # bereitgestellt werden - siehe HOWTO-neuer-faiserver.md, Abschnitt 4,
    # fuer den vollstaendigen Beschaffungsweg (offizielles .img-Release von
    # github.com/PartialVolume/shredos.x86_64, Kernel per Loopback-Mount
    # extrahiert). Kein Bestandteil dieses Repos (Binaerdatei, analog zu
    # anderen reinen Server-Assets. Aktuelle ShredOS-Releases (ab v0.42)
    # liefern ein einziges self-contained bzImage mit eingebettetem
    # Initramfs - kein separates initrd mehr, daher kein append initrd=
    # noetig. console=tty3 loglevel=3 uebernommen aus ShredOS' eigenem
    # grub.cfg-Standardeintrag.
    mac_dashes="${mac//:/-}"
    cfg="/srv/tftp/fai/pxelinux.cfg/01-${mac_dashes}"
    cat > "$cfg" <<EOF
default shredos

label shredos
linux shredos/vmlinuz

# generated by fai-discovery-chboot wipe for host ${mac}
append console=tty3 loglevel=3
EOF
    echo "ShredOS-Wipe-PXE-Config fuer ${mac} geschrieben: ${cfg}"
    ;;
  *)
    echo "Fehler: unbekannter Modus '$mode' (erwartet: approve, discovery, disable oder wipe)" >&2
    exit 1
    ;;
esac
