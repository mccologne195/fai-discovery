class State:
    def __init__(self):
        self.st = dict(kind="info", line=tr("starting"), sub="", detail="", pct=None)
        self.done_weight = 0
        self.err = False
        self.wait_enter = False          # Installation fertig, FAI wartet auf Enter (Flag reboot fehlt)
        self.title = "FAI Discovery"

    @staticmethod
    def fai_flags():
        try:
            for w in open("/proc/cmdline").read().split():
                if w.startswith("FAI_FLAGS="):
                    return w.split("=", 1)[1].replace('"', "").split(",")
        except OSError:
            pass
        return []

    def monitor(self, line):
        parts = line.split()
        if not parts:
            return
        ev = parts[0]
        name = parts[1] if len(parts) > 1 else ""
        if ev == "TASKBEGIN" and name == "faiend" and not self.err:
            # task_faiend kehrt ohne reboot-Flag nie zurueck (wartet auf Enter), TASKEND kommt dann nicht
            auto = "reboot" in self.fai_flags() or "halt" in self.fai_flags()
            self.done_weight = TOTAL_WEIGHT
            self.wait_enter = not auto
            self.st.update(kind="ok", line=tr("install_done"), pct=100,
                           sub=tr("done_reboot") if auto else tr("done_enter"))
        elif ev == "TASKBEGIN" and name in TASK_INDEX:
            i = TASK_INDEX[name]
            label = task_label(i)
            self.st.update(kind="error" if self.err else "info",
                           line=tr("install_running") if not self.err else self.st["line"],
                           sub=tr("step_of", i + 1, len(TASKS), label),
                           pct=min(99, int(100 * self.done_weight / TOTAL_WEIGHT)))
        elif ev in ("TASKEND", "TASKSKIP") and name in TASK_INDEX:
            err = parts[2] if (ev == "TASKEND" and len(parts) > 2) else "0"
            self.done_weight = sum(t[2] for t in TASKS[:TASK_INDEX[name] + 1])
            self.st["pct"] = min(100, int(100 * self.done_weight / TOTAL_WEIGHT))
            if err not in ("0", ""):
                self.err = True
                self.st.update(kind="error", line=tr("error_step", task_label(TASK_INDEX[name])),
                               sub=tr("error_hint"))
            if name == "faiend" and not self.err:
                self.st.update(kind="ok", line=tr("install_done"),
                               sub=tr("done_reboot"), pct=100)
        elif ev == "TASKERROR":
            self.err = True
            self.st.update(kind="error", line=tr("error_task", name),
                           sub=tr("error_hint"))

    def say(self, kind, line, sub, detail, pct):
        if line is not None:
            self.st["line"] = line
        self.st["kind"] = kind or self.st["kind"]
        if sub is not None:
            self.st["sub"] = sub
        if detail is not None:
            self.st["detail"] = detail
        self.st["pct"] = None if pct is None or pct < 0 else pct


def parse_msg(line):
    # say-Format: kind \x1f line \x1f sub \x1f detail \x1f pct
    p = line.rstrip("\n").split("\x1f")
    if len(p) != 5:
        return None
    pct = int(p[4]) if p[4].lstrip("-").isdigit() else None
    return p[0], p[1], p[2], p[3], pct


class Tail:
    def __init__(self, path):
        self.path, self.pos, self.rest = path, 0, ""

    def lines(self):
        try:
            size = os.path.getsize(self.path)
        except OSError:
            return []
        if size < self.pos:
            self.pos = 0
        if size == self.pos:
            return []
        with open(self.path, "r", errors="replace") as f:
            f.seek(self.pos)
            data = f.read()
            self.pos = f.tell()
        data = self.rest + data
        parts = data.split("\n")
        self.rest = parts.pop()
        return parts


# --------------------------------------------------------------------------
# Framebuffer und virtuelles Terminal
# --------------------------------------------------------------------------
KDSETMODE, KD_TEXT, KD_GRAPHICS = 0x4B3A, 0, 1
VT_ACTIVATE, VT_WAITACTIVE = 0x5606, 0x5607
VT_SETMODE, VT_RELDISP = 0x5602, 0x5605
VT_AUTO, VT_PROCESS, VT_ACKACQ = 0, 1, 2
FBIOGET_VSCREENINFO = 0x4600
FBIOPAN_DISPLAY = 0x4606


class Fb:
    """Framebuffer. Geschrieben wird per write() statt per mmap: Bei i915 (und anderen DRM-Treibern) markiert
    write() die Zeilen als geaendert, ueber mmap geschriebene Daten werden dort nicht zwingend auf das Display
    uebernommen (Display bleibt statisch). Zusaetzlich loest FBIOPAN_DISPLAY nach jedem Zeichnen einen Flip aus."""

    def __init__(self, dev="/dev/fb0"):
        import fcntl
        self.fd = os.open(dev, os.O_RDWR)
        info = fcntl.ioctl(self.fd, FBIOGET_VSCREENINFO, b"\0" * 160)
        v = struct.unpack("<20I", info[:80])
        self.w, self.h, self.bpp = v[0], v[1], v[6]
        self.roff, self.goff, self.boff = v[8], v[11], v[14]
        if self.bpp != 32:
            os.close(self.fd)
            raise RuntimeError("framebuffer has %d bpp, only 32 supported" % self.bpp)
        base = os.path.basename(dev)
        try:
            self.stride = int(open("/sys/class/graphics/%s/stride" % base).read())
        except (OSError, ValueError):
            self.stride = self.w * 4
        pan = bytearray(info)
        struct.pack_into("<2I", pan, 16, 0, 0)               # xoffset, yoffset = 0
        self._pan = bytes(pan)
        self.reset_pan()

    def close(self):
        try:
            os.close(self.fd)
        except OSError:
            pass

    def reset_pan(self):
        """Sichtbaren Ausschnitt auf Zeile 0 setzen (fbcon scrollt per Panning) und dabei einen Flip ausloesen."""
        import fcntl
        try:
            fcntl.ioctl(self.fd, FBIOPAN_DISPLAY, self._pan)
        except OSError:
            pass

    def _write(self, data, offset):
        view = memoryview(data)
        while len(view):
            n = os.pwrite(self.fd, view, offset)
            view, offset = view[n:], offset + n

    def blit(self, canvas, y0=0, y1=None):
        y1 = canvas.h if y1 is None else y1
        rowlen = canvas.w * 4
        if self.stride == rowlen:
            self._write(bytes(canvas.buf[y0 * rowlen:y1 * rowlen]), y0 * self.stride)
        else:
            for y in range(y0, y1):
                self._write(bytes(canvas.buf[y * rowlen:(y + 1) * rowlen]), y * self.stride)
        self.reset_pan()


def fb_signature(dev="/dev/fb0"):
    """Kennzeichnet den aktuellen Framebuffer. Aendert er sich (z. B. efifb -> i915drmfb, wenn udev den
    Grafiktreiber erst nach dem Start nachlaedt), muss neu geoeffnet und neu gezeichnet werden."""
    base = "/sys/class/graphics/" + os.path.basename(dev)
    sig = []
    for f in ("name", "virtual_size", "stride", "bits_per_pixel"):
        try:
            sig.append(open(os.path.join(base, f)).read().strip())
        except OSError:
            sig.append("-")
    return tuple(sig)


class Vt:
    """Eigenes virtuelles Terminal im Grafikmodus. Im Modus VT_AUTO sperrt der Kernel das Umschalten
    (Alt+F1 ginge dann nicht mehr), daher VT_PROCESS: der Kernel schickt uns SIGUSR1 (wir sollen
    freigeben) und SIGUSR2 (wir bekommen das Terminal zurueck), beides quittieren wir."""

    def __init__(self, num):
        self.num = num
        self.fd = os.open("/dev/tty%d" % num, os.O_RDWR)
        signal.signal(signal.SIGUSR1, self._release)
        signal.signal(signal.SIGUSR2, self._acquire)

    def raw_input(self):
        """Eingaben auf diesem Terminal ohne Echo und Zeilenpuffer lesbar machen."""
        try:
            attrs = termios.tcgetattr(self.fd)
            attrs[3] &= ~(termios.ICANON | termios.ECHO)
            attrs[6][termios.VMIN], attrs[6][termios.VTIME] = 0, 0
            termios.tcsetattr(self.fd, termios.TCSANOW, attrs)
        except (termios.error, OSError):
            pass

    def flush_input(self):
        try:
            termios.tcflush(self.fd, termios.TCIFLUSH)
        except (termios.error, OSError):
            pass

    def enter_pressed(self):
        try:
            if select.select([self.fd], [], [], 0)[0]:
                return bool(set(os.read(self.fd, 64)) & {10, 13})
        except OSError:
            pass
        return False

    def _release(self, *_):
        import fcntl
        try:
            fcntl.ioctl(self.fd, VT_RELDISP, 1)           # Umschalten erlauben
        except OSError:
            pass

    def _acquire(self, *_):
        import fcntl
        try:
            fcntl.ioctl(self.fd, VT_RELDISP, VT_ACKACQ)   # Rueckkehr bestaetigen
        except OSError:
            pass

    def graphics(self):
        import fcntl
        fcntl.ioctl(self.fd, KDSETMODE, KD_GRAPHICS)
        fcntl.ioctl(self.fd, VT_SETMODE,
                    struct.pack("bbhhh", VT_PROCESS, 0, signal.SIGUSR1, signal.SIGUSR2, 0))
        fcntl.ioctl(self.fd, VT_ACTIVATE, self.num)
        fcntl.ioctl(self.fd, VT_WAITACTIVE, self.num)
        self.raw_input()

    def restore(self):
        import fcntl
        try:
            fcntl.ioctl(self.fd, VT_SETMODE, struct.pack("bbhhh", VT_AUTO, 0, 0, 0, 0))
            fcntl.ioctl(self.fd, KDSETMODE, KD_TEXT)
            fcntl.ioctl(self.fd, VT_ACTIVATE, 1)
        except OSError:
            pass

    def active(self):
        try:
            return open("/sys/class/tty/tty0/active").read().strip() == "tty%d" % self.num
        except OSError:
            return True


