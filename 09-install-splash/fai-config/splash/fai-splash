def _mon_target():
    """Server und Sende-ID wie FAI-sendmon: Server aus FAI_CONFIG_SRC (nfs://HOST/...), Sende-ID = MAC des Default-Interface."""
    host, port, sid = None, 4711, "splash"
    try:
        for w in open("/proc/cmdline").read().split():
            if w.startswith("FAI_CONFIG_SRC=") and "://" in w:
                host = w.split("://", 1)[1].split("/", 1)[0]
            elif w.startswith("FAI_MONITOR_PORT="):
                port = int(w.split("=", 1)[1])
        nic = None
        for line in open("/proc/net/route").read().splitlines()[1:]:
            f = line.split()
            if f[1] == "00000000":
                nic = f[0]
                break
        if nic:
            sid = open("/sys/class/net/%s/address" % nic).read().strip()
    except (OSError, ValueError, IndexError):
        pass
    return host, port, sid


_MON = None


def dbg(msg):
    """Diagnose: in splash.log und, mit "splashdebug" auf der Kernel-Kommandozeile, als 'SPLASH ...'-Zeile an den FAI-Monitor des Servers (erscheint dort in fai-monitor.log)."""
    global _MON
    msg = " ".join(str(msg).split())
    try:
        with open(LOG_FILE, "a") as f:
            f.write("%s %s\n" % (time.strftime("%H:%M:%S"), msg))
    except OSError:
        pass
    try:
        # an den Monitor des Servers nur auf Wunsch ("splashdebug" auf der Kernel-Kommandozeile),
        # sonst landet jeder Herzschlag in fai-monitor.log
        if "splashdebug" not in open("/proc/cmdline").read().split():
            return
        if _MON is None:
            _MON = _mon_target()
        host, port, sid = _MON
        if host:
            c = socket.create_connection((host, port), timeout=1.5)
            c.sendall(("%s SPLASH %s\n" % (sid, msg[:400])).encode("utf-8", "replace"))
            c.close()
    except OSError:
        pass


# --------------------------------------------------------------------------
# PNG-Dekoder (nicht interlaced, 8 Bit, RGB/RGBA) und -Encoder (Vorschau)
# --------------------------------------------------------------------------
def read_png(path):
    data = open(path, "rb").read()
    if data[:8] != b"\x89PNG\r\n\x1a\n":
        raise ValueError("kein PNG")
    pos, idat = 8, []
    while pos < len(data):
        ln = struct.unpack(">I", data[pos:pos + 4])[0]
        typ = data[pos + 4:pos + 8]
        chunk = data[pos + 8:pos + 8 + ln]
        pos += 12 + ln
        if typ == b"IHDR":
            w, h, depth, ctype, _, _, interlace = struct.unpack(">IIBBBBB", chunk)
        elif typ == b"IDAT":
            idat.append(chunk)
    if depth != 8 or ctype not in (2, 6) or interlace:
        raise ValueError("PNG-Format nicht unterstuetzt")
    bpp = 4 if ctype == 6 else 3
    raw = zlib.decompress(b"".join(idat))
    stride = w * bpp
    out = bytearray(h * stride)
    prev = bytearray(stride)
    p = 0
    for y in range(h):
        ft = raw[p]
        line = bytearray(raw[p + 1:p + 1 + stride])
        p += 1 + stride
        if ft == 1:
            for i in range(bpp, stride):
                line[i] = (line[i] + line[i - bpp]) & 255
        elif ft == 2:
            for i in range(stride):
                line[i] = (line[i] + prev[i]) & 255
        elif ft == 3:
            for i in range(stride):
                left = line[i - bpp] if i >= bpp else 0
                line[i] = (line[i] + ((left + prev[i]) >> 1)) & 255
        elif ft == 4:
            for i in range(stride):
                a = line[i - bpp] if i >= bpp else 0
                b = prev[i]
                c = prev[i - bpp] if i >= bpp else 0
                pa, pb, pc = abs(b - c), abs(a - c), abs(a + b - 2 * c)
                pr = a if (pa <= pb and pa <= pc) else (b if pb <= pc else c)
                line[i] = (line[i] + pr) & 255
        out[y * stride:(y + 1) * stride] = line
        prev = line
    return w, h, bpp, bytes(out)


def write_png(path, w, h, rgb):
    """rgb: bytes mit w*h*3 Byte."""
    def chunk(typ, payload):
        body = typ + payload
        return struct.pack(">I", len(payload)) + body + struct.pack(">I", zlib.crc32(body) & 0xffffffff)
    rows = b"".join(b"\x00" + rgb[y * w * 3:(y + 1) * w * 3] for y in range(h))
    with open(path, "wb") as f:
        f.write(b"\x89PNG\r\n\x1a\n")
        f.write(chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0)))
        f.write(chunk(b"IDAT", zlib.compress(rows, 6)))
        f.write(chunk(b"IEND", b""))


# --------------------------------------------------------------------------
# PSF-Schrift
# --------------------------------------------------------------------------
class Font:
    def __init__(self):
        data = None
        for cand in FONT_CANDIDATES:
            if cand and os.path.exists(cand):
                data = gzip.open(cand).read() if cand.endswith(".gz") else open(cand, "rb").read()
                break
        if data is None:
            raise RuntimeError("keine PSF-Schrift gefunden")
        has_table = False
        if data[:2] == b"\x36\x04":                 # PSF1: 8 Pixel breit
            mode, self.h = data[2], data[3]
            self.w, n, start, self.charsize = 8, (512 if mode & 1 else 256), 4, self.h
            has_table = bool(mode & 2)
            psf2 = False
        elif data[:4] == b"\x72\xb5\x4a\x86":       # PSF2
            _, hsize, flags, n, self.charsize, self.h, self.w = struct.unpack("<7I", data[4:32])
            start = hsize
            has_table = bool(flags & 1)
            psf2 = True
        else:
            raise RuntimeError("PSF-Format unbekannt")
        self.rowbytes = (self.w + 7) // 8
        self.glyphs = [data[start + i * self.charsize:start + (i + 1) * self.charsize] for i in range(n)]
        self.unicode = self._read_unicode_table(data[start + n * self.charsize:], n, psf2) if has_table else {}
        self._cache = {}

    @staticmethod
    def _read_unicode_table(table, n, psf2):
        """Unicode-Zeichen -> Glyph-Nummer aus der Tabelle am Dateiende. Zusammengesetzte Folgen
        (Marker 0xFE/0xFFFE) werden uebersprungen, bei doppelten Zeichen gilt der erste Eintrag."""
        mapping = {}
        pos = 0
        if psf2:
            for glyph in range(n):
                end = table.find(b"\xff", pos)
                if end < 0:
                    break
                entry = table[pos:end].split(b"\xfe")[0]
                pos = end + 1
                for ch in entry.decode("utf-8", "ignore"):
                    mapping.setdefault(ord(ch), glyph)
        else:
            for glyph in range(n):
                while pos + 1 < len(table):
                    value = table[pos] | (table[pos + 1] << 8)
                    pos += 2
                    if value == 0xFFFF:
                        break
                    if value == 0xFFFE:                 # ab hier Folgen, bis zum Ende des Eintrags ueberspringen
                        while pos + 1 < len(table) and (table[pos] | (table[pos + 1] << 8)) != 0xFFFF:
                            pos += 2
                        pos += 2
                        break
                    mapping.setdefault(value, glyph)
        return mapping

    def glyph_rows(self, ch):
        """Liste von Zeilen, jede Zeile eine Liste von 0/1 (w Eintraege)."""
        # Mit Unicode-Tabelle in der Schrift (die Regel) gilt sie, sonst die Latin-9-Reihenfolge
        idx = self.unicode.get(ord(ch)) if self.unicode else None
        if idx is None:
            try:
                idx = ch.encode("iso-8859-15")[0]
            except (UnicodeEncodeError, IndexError):
                idx = ord("?")
        if idx not in self._cache:
            g = self.glyphs[idx] if idx < len(self.glyphs) else self.glyphs[ord("?")]
            rows = []
            for y in range(self.h):
                rb = g[y * self.rowbytes:(y + 1) * self.rowbytes]
                bits = []
                for x in range(self.w):
                    bits.append((rb[x // 8] >> (7 - x % 8)) & 1)
                rows.append(bits)
            self._cache[idx] = rows
        return self._cache[idx]


# --------------------------------------------------------------------------
# Bild-Puffer (BGRX, wie fast alle Linux-Framebuffer mit 32 Bit)
# --------------------------------------------------------------------------
class Canvas:
    def __init__(self, w, h, roff=16, goff=8, boff=0):
        self.w, self.h = w, h
        self.offs = (roff // 8, goff // 8, boff // 8)       # Byteposition von R, G, B
        self.buf = bytearray(w * h * 4)

    def px(self, c):
        b = bytearray(4)
        b[self.offs[0]], b[self.offs[1]], b[self.offs[2]] = c
        return bytes(b)

    def fill_gradient(self, top, bottom):
        for y in range(self.h):
            t = y / max(1, self.h - 1)
            c = tuple(int(top[i] + (bottom[i] - top[i]) * t) for i in range(3))
            self.buf[y * self.w * 4:(y + 1) * self.w * 4] = self.px(c) * self.w

    def rect(self, x, y, w, h, c):
        x0, y0 = max(0, x), max(0, y)
        x1, y1 = min(self.w, x + w), min(self.h, y + h)
        if x1 <= x0 or y1 <= y0:
            return
        row = self.px(c) * (x1 - x0)
        for yy in range(y0, y1):
            o = (yy * self.w + x0) * 4
            self.buf[o:o + len(row)] = row

    def blend_icon(self, icon, ix, iy, size):
        """icon = (w, h, bpp, bytes); skaliert bilinear auf size x size und mischt per Alpha."""
        sw, sh, bpp, src = icon
        for oy in range(size):
            fy = (oy + 0.5) * sh / size - 0.5
            y0 = max(0, min(sh - 1, int(fy)))
            y1 = min(sh - 1, y0 + 1)
            wy = max(0.0, min(1.0, fy - y0))
            dy = iy + oy
            if not 0 <= dy < self.h:
                continue
            for ox in range(size):
                fx = (ox + 0.5) * sw / size - 0.5
                x0 = max(0, min(sw - 1, int(fx)))
                x1 = min(sw - 1, x0 + 1)
                wx = max(0.0, min(1.0, fx - x0))
                dx = ix + ox
                if not 0 <= dx < self.w:
                    continue
                vals = []
                for k in range(bpp):
                    a = src[(y0 * sw + x0) * bpp + k] * (1 - wx) + src[(y0 * sw + x1) * bpp + k] * wx
                    b = src[(y1 * sw + x0) * bpp + k] * (1 - wx) + src[(y1 * sw + x1) * bpp + k] * wx
                    vals.append(a * (1 - wy) + b * wy)
                alpha = vals[3] / 255.0 if bpp == 4 else 1.0
                if alpha <= 0.0:
                    continue
                o = (dy * self.w + dx) * 4
                for ch in range(3):
                    dst = self.buf[o + self.offs[ch]]
                    self.buf[o + self.offs[ch]] = int(vals[ch] * alpha + dst * (1 - alpha))

    def text_width(self, font, text, scale):
        return len(text) * font.w * scale

    def text(self, font, x, y, s, scale, c):
        px = self.px(c)
        for i, ch in enumerate(s):
            if ch == " ":
                continue
            gx = x + i * font.w * scale
            for gy, bits in enumerate(font.glyph_rows(ch)):
                run = None
                for bx in range(font.w + 1):
                    on = bx < font.w and bits[bx]
                    if on and run is None:
                        run = bx
                    elif not on and run is not None:
                        rw = (bx - run) * scale
                        for sy in range(scale):
                            yy = y + gy * scale + sy
                            xx = gx + run * scale
                            if 0 <= yy < self.h and 0 <= xx < self.w:
                                o = (yy * self.w + xx) * 4
                                n = min(rw, self.w - xx)
                                self.buf[o:o + n * 4] = px * n
                        run = None

    def text_center(self, font, y, s, scale, c):
        self.text(font, (self.w - self.text_width(font, s, scale)) // 2, y, s, scale, c)

    def to_rgb(self):
        r, g, b = self.offs
        out = bytearray(self.w * self.h * 3)
        out[0::3] = self.buf[r::4]
        out[1::3] = self.buf[g::4]
        out[2::3] = self.buf[b::4]
        return bytes(out)


# --------------------------------------------------------------------------
# Darstellung
# --------------------------------------------------------------------------
class Ui:
    def __init__(self, canvas, font, icon):
        self.cv, self.font, self.icon = canvas, font, icon
        self.base = None            # fertig gezeichneter statischer Hintergrund
        h = canvas.h
        self.s_title = max(3, round(h / 200))
        self.s_line = max(2, round(h / 320))
        self.s_small = max(2, round(h / 480))
        self.stripe_h = max(4, h // 80)
        self.icon_size = int(min(h * 0.34, 400))
        self.icon_y = int(h * 0.07)
        self.title_y = self.icon_y + self.icon_size + int(h * 0.04)
        self.line_y = self.title_y + font.h * self.s_title + int(h * 0.05)
        self.sub_y = self.line_y + font.h * self.s_line + int(h * 0.02)
        self.bar_y = self.sub_y + font.h * self.s_small + int(h * 0.04)
        self.bar_h = max(8, h // 60)
        self.bar_w = int(canvas.w * 0.5)
        self.detail_y = self.bar_y + self.bar_h + int(h * 0.085)
        self.hint_y = h - self.stripe_h * 4 - font.h * self.s_small - int(h * 0.03)
        self.dyn_top = self.line_y - 4
        self.dyn_bottom = self.detail_y + font.h * self.s_small + 4
        # Namensnennung unter dem Tastenhinweis, klein; passt sie nicht mehr ueber die Streifen, entfaellt sie
        self.credit_s = max(1, self.s_small - 1)
        self.credit_y = self.hint_y + font.h * self.credit_s + max(4, int(h * 0.01))
        self.credit_fits = self.credit_y + font.h * self.credit_s <= h - self.stripe_h * 4 - 2

    def draw_static(self, title):
        cv = self.cv
        cv.fill_gradient(BG_TOP, BG_BOTTOM)
        sh = self.stripe_h
        for i, c in enumerate(STRIPES):
            cv.rect(0, cv.h - sh * (4 - i), cv.w, sh, c)
        if self.icon:
            cv.blend_icon(self.icon, (cv.w - self.icon_size) // 2, self.icon_y, self.icon_size)
        cv.text_center(self.font, self.title_y, title, self.s_title, CREAM)
        if self.credit_fits:
            cv.text_center(self.font, self.credit_y, tr("credit"), self.credit_s, (95, 100, 108))
        self.base = bytes(cv.buf)

    def draw_dynamic(self, st):
        cv, f = self.cv, self.font
        # dynamischen Bereich aus dem statischen Hintergrund wiederherstellen
        a, b = self.dyn_top * cv.w * 4, self.dyn_bottom * cv.w * 4
        cv.buf[a:b] = self.base[a:b]
        color = KIND_COLOR.get(st["kind"], GREEN)
        cv.text_center(f, self.line_y, st["line"], self.s_line, color if st["kind"] == "error" else CREAM)
        if st["sub"]:
            cv.text_center(f, self.sub_y, st["sub"], self.s_small, MUTED)
        if st["pct"] is not None:
            x = (cv.w - self.bar_w) // 2
            cv.rect(x, self.bar_y, self.bar_w, self.bar_h, TRACK)
            cv.rect(x, self.bar_y, int(self.bar_w * st["pct"] / 100.0), self.bar_h, color)
            cv.text_center(f, self.bar_y + self.bar_h + int(cv.h * 0.012), "%d %%" % st["pct"], self.s_small, MUTED)
        elif st["kind"] == "wait":
            # unbestimmter Fortschritt: kleiner laufender Block
            x = (cv.w - self.bar_w) // 2
            cv.rect(x, self.bar_y, self.bar_w, self.bar_h, TRACK)
            span = self.bar_w // 5
            pos = int((time.time() * 0.6 % 1.0) * (self.bar_w - span))
            cv.rect(x + pos, self.bar_y, span, self.bar_h, YELLOW)
        if st["detail"]:
            cv.text_center(f, self.detail_y, st["detail"], self.s_small, MUTED)
        # Loeschflaeche nur so hoch wie der Hinweis selbst, sonst wuerde sie die Zeile darunter ueberdecken
        cv.rect(0, self.hint_y - 2, cv.w, f.h * self.credit_s + 4, BG_BOTTOM)
        cv.text_center(f, self.hint_y, tr("keys_hint"), self.credit_s, (95, 100, 108))


