def reboot_now():
    """Neustart wie FAI selbst (faireboot haengt Dateisysteme sauber aus), sonst hart."""
    for cmd in (["/usr/sbin/faireboot"], ["reboot", "-f"]):
        try:
            subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return
        except OSError:
            continue


def build_ui(icon):
    fb = Fb()
    cv = Canvas(fb.w, fb.h, fb.roff, fb.goff, fb.boff)
    ui = Ui(cv, Font(), icon)
    ui.draw_static("FAI Discovery")
    return fb, cv, ui


def serve():
    os.makedirs(LOGDIR, exist_ok=True)
    try:
        icon = read_png(ICON)
    except (OSError, ValueError):
        icon = None
    dbg("start pid=%d" % os.getpid())
    # Bei BIOS-Boot gibt es anfangs keinen /dev/fb0, der DRM-Treiber wird erst spaeter (udev) geladen: warten.
    deadline = time.time() + 180
    while True:
        try:
            fb, cv, ui = build_ui(icon)
            break
        except (OSError, RuntimeError) as e:
            if time.time() > deadline:
                dbg("no usable framebuffer (%r), splash off" % (e,))
                os._exit(0)
            time.sleep(0.5)
    sig = fb_signature()
    dbg("fb %s %dx%d stride=%d" % (sig, fb.w, fb.h, fb.stride))
    state = State()
    vt = Vt(VT_NUM)

    def cleanup(*_):
        vt.restore()
        try:
            os.unlink(PID_FILE)
        except OSError:
            pass
        sys.exit(0)

    signal.signal(signal.SIGTERM, cleanup)
    signal.signal(signal.SIGINT, cleanup)

    vt.graphics()
    dbg("vt graphics ok, active=%s" % vt.active())
    mon, msg = Tail(MON_FILE), Tail(MSG_FILE)
    was_active, last, stale = False, None, False
    t_beat, draws, armed = 0.0, 0, False
    while True:
        if time.time() - t_beat > 15:
            t_beat = time.time()
            dbg("beat active=%s fb=%s drawn=%d stale=%s state=%s" % (
                vt.active(), fb_signature(), draws, stale, state.st))
        for line in mon.lines():
            state.monitor(line)
        for line in msg.lines():
            m = parse_msg(line)
            if m:
                state.say(*m)
        # Grafiktreiber-Wechsel (efifb -> i915 usw.): neu oeffnen, VT erneut in den Grafikmodus
        now = fb_signature()
        if now != sig or stale:
            fb.close()
            try:
                fb, cv, ui = build_ui(icon)
                sig, stale, was_active, last = fb_signature(), False, False, None
                dbg("framebuffer changed to %s %dx%d stride=%d" % (sig, fb.w, fb.h, fb.stride))
                vt.graphics()
                dbg("vt graphics ok after change, active=%s" % vt.active())
            except (OSError, RuntimeError) as e:
                dbg("rebuild failed: %r" % (e,))
                stale = True                     # fb0 gerade weg (Treiber-Uebernahme), spaeter nochmal
                time.sleep(0.5)
                continue
        if state.wait_enter:
            if not armed:
                vt.flush_input()                 # fruehere Tastendruecke verwerfen
                armed = True
            elif vt.enter_pressed():
                dbg("Enter on the display -> reboot")
                state.wait_enter = False
                state.st.update(kind="ok", sub=tr("rebooting"))
                reboot_now()
        active = vt.active()
        key = repr(state.st)
        animated = state.st["kind"] == "wait" and state.st["pct"] is None
        if active and (not was_active or key != last or animated):
            try:
                ui.draw_dynamic(state.st)
                if not was_active:
                    fb.reset_pan()
                    fb.blit(cv)                  # nach Rueckkehr von einer anderen VT komplett
                else:
                    fb.blit(cv, ui.dyn_top, min(cv.h, ui.dyn_bottom))
                last = key
                draws += 1
            except (OSError, ValueError) as e:
                dbg("drawing failed: %r" % (e,))
                stale = True                     # Framebuffer ungueltig geworden
        was_active = active
        time.sleep(0.25)


def daemonize():
    if os.fork():
        os._exit(0)
    os.setsid()
    if os.fork():
        os._exit(0)
    os.makedirs(LOGDIR, exist_ok=True)
    log = os.open(LOG_FILE, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
    null = os.open(os.devnull, os.O_RDONLY)
    os.dup2(null, 0)
    os.dup2(log, 1)
    os.dup2(log, 2)
    with open(PID_FILE, "w") as f:
        f.write(str(os.getpid()))


ALLOW_FILE = os.path.join(HERE, "allow-macs")


def allowed():
    """Der Splash ist nur an, wenn splash/allow-macs existiert: die Zeile 'all' schaltet ihn fuer alle Clients
    an, sonst nur fuer die aufgelisteten MAC-Adressen (eine pro Zeile, # = Kommentar). Ohne Datei bleibt er aus.
    Die Datei schreibt install.sh aus site.conf (FAI_DISCOVERY_SPLASH_ENABLED / _MACS)."""
    try:
        lines = [l.split("#")[0].strip().lower() for l in open(ALLOW_FILE)]
    except OSError:
        return False
    wanted = {l for l in lines if l}
    if "all" in wanted:
        return True
    try:
        nics = os.listdir("/sys/class/net")
    except OSError:
        return False
    for nic in nics:
        try:
            if open("/sys/class/net/%s/address" % nic).read().strip().lower() in wanted:
                return True
        except OSError:
            pass
    return False


def cmd_start(_):
    if not allowed():
        return 0
    if os.path.exists(PID_FILE):
        try:
            os.kill(int(open(PID_FILE).read()), 0)
            return 0                           # laeuft schon
        except (OSError, ValueError):
            pass
    daemonize()
    try:
        serve()
    except SystemExit:
        raise
    except Exception as e:                      # noqa: BLE001
        dbg("ABORT: %r %s" % (e, traceback.format_exc().replace(chr(10), " | ")))
        print("fai-splash: Abbruch: %r" % e)
        try:
            os.unlink(PID_FILE)
        except OSError:
            pass
        try:
            Vt(VT_NUM).restore()
        except Exception:                       # noqa: BLE001
            pass
    return 0


def cmd_stop(_):
    try:
        os.kill(int(open(PID_FILE).read()), signal.SIGTERM)
    except (OSError, ValueError):
        pass
    return 0


def cmd_say(a):
    os.makedirs(LOGDIR, exist_ok=True)
    if a.msg:
        # Zeile/Unterzeile aus dem Textverzeichnis; unbekannte Namen duerfen die Installation nie stoeren
        if a.line is None:
            a.line = TEXT.get("msg.%s.line" % a.msg, {}).get(LANG, "")
        if a.sub is None:
            a.sub = TEXT.get("msg.%s.sub" % a.msg, {}).get(LANG, "")
    line = "\x1f".join([a.kind or "", a.line or "", a.sub or "", a.detail or "",
                        str(a.pct) if a.pct is not None else "-1"])
    with open(MSG_FILE, "a") as f:
        f.write(line + "\n")
    return 0


def preview_states():
    return {
        "boot": dict(kind="info", line=tr("starting"), sub="", detail="", pct=None),
        "wait": dict(kind="wait", line=tr("msg.waiting.line"), sub=tr("msg.waiting.sub"),
                     detail="MAC aa:bb:cc:dd:ee:ff   IP 192.0.2.10", pct=None),
        "install": dict(kind="info", line=tr("install_running"),
                        sub=tr("step_of", 11, len(TASKS), TASKS[10][1][LANG]),
                        detail="client01   192.0.2.10", pct=48),
        "done": dict(kind="ok", line=tr("install_done"), sub=tr("done_enter"), detail="", pct=100),
        "error": dict(kind="error", line=tr("error_step", TASKS[10][1][LANG]),
                      sub=tr("error_hint"), detail="", pct=48),
    }


def cmd_preview(a):
    global LANG
    if a.lang:
        LANG = a.lang
    w, h = (int(x) for x in a.size.split("x"))
    cv = Canvas(w, h)
    try:
        icon = read_png(ICON)
    except (OSError, ValueError):
        icon = None
    ui = Ui(cv, Font(), icon)
    ui.draw_static("FAI Discovery")
    ui.draw_dynamic(preview_states()[a.state])
    write_png(a.file, w, h, cv.to_rgb())
    return 0


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("start").set_defaults(fn=cmd_start)
    sub.add_parser("stop").set_defaults(fn=cmd_stop)
    s = sub.add_parser("say")
    s.add_argument("-k", "--kind", choices=["info", "wait", "ok", "error"])
    s.add_argument("-m", "--msg", help="Meldungsname aus dem Textverzeichnis (zweisprachig)")
    s.add_argument("-l", "--line")
    s.add_argument("-s", "--sub")
    s.add_argument("-d", "--detail")
    s.add_argument("-p", "--pct", type=int)
    s.set_defaults(fn=cmd_say)
    p = sub.add_parser("preview")
    p.add_argument("file")
    p.add_argument("--state", choices=["boot", "wait", "install", "done", "error"], default="install")
    p.add_argument("--lang", choices=LANGUAGES, help="Sprache der Vorschau (sonst wie im Betrieb)")
    p.add_argument("--size", default="1280x800")
    p.set_defaults(fn=cmd_preview)
    a = ap.parse_args()
    sys.exit(a.fn(a))


if __name__ == "__main__":
    main()
