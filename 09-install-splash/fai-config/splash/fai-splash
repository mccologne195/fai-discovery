    """FAI_SPLASH_LANG, sonst Datei 'lang' neben dem Skript, sonst Deutsch. Unbekannte Werte -> Deutsch."""
    value = os.environ.get("FAI_SPLASH_LANG", "")
    if not value:
        try:
            value = open(os.path.join(HERE, "lang")).read()
        except OSError:
            value = ""
    value = value.strip().lower()
    return value if value in LANGUAGES else DEFAULT_LANGUAGE


